<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6F8"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="实验三 · Android 界面组件"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:gravity="center"/>

    <Button
        android:id="@+id/btn_listview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="1. ListView + SimpleAdapter"
        android:textSize="16sp"/>

    <Button
        android:id="@+id/btn_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="2. 自定义布局的 AlertDialog"
        android:textSize="16sp"/>

    <Button
        android:id="@+id/btn_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="3. 使用 XML 定义菜单"
        android:textSize="16sp"/>

    <Button
        android:id="@+id/btn_actionmode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="4. ActionMode 上下文菜单"
        android:textSize="16sp"/>

    <Button
        android:id="@+id/btn_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="5. RecyclerView 列表"
        android:textSize="16sp"/>

</LinearLayout>
